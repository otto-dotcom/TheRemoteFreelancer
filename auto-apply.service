[Unit]
Description=Auto-apply job board automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nobody
WorkingDirectory=/opt/auto-apply
ExecStart=/usr/bin/python3 /opt/auto-apply/auto-apply.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
