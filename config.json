{
  "boards": {
    "remoteok": {
      "api_url": "https://remoteok.io/api",
      "enabled": true,
      "max_per_day": 200,
      "rate_limit": {
        "max_requests": 100,
        "window_seconds": 3600
      }
    },
    "weworkremotely": {
      "api_url": "https://weworkremotely.com/api",
      "enabled": true,
      "max_per_day": 150,
      "rate_limit": {
        "max_requests": 80,
        "window_seconds": 3600
      }
    },
    "angellist": {
      "api_url": "https://api.angel.co/1",
      "enabled": true,
      "max_per_day": 100,
      "rate_limit": {
        "max_requests": 60,
        "window_seconds": 3600
      }
    },
    "freelancer": {
      "api_url": "https://api.freelancer.com",
      "enabled": true,
      "max_per_day": 50,
      "rate_limit": {
        "max_requests": 40,
        "window_seconds": 3600
      }
    }
  },
  "filters": {
    "min_salary": 35000,
    "max_salary": null,
    "required_skills": [
      "python",
      "javascript",
      "typescript",
      "java",
      "go",
      "rust",
      "c++",
      "php",
      "ruby",
      "kotlin"
    ],
    "job_types": [
      "full-time",
      "contract",
      "freelance",
      "temporary"
    ],
    "locations": [
      "Anywhere",
      "Remote",
      "World",
      "Global"
    ],
    "exclude_keywords": [
      "unpaid",
      "equity-only",
      "no-pay",
      "volunteer"
    ]
  },
  "application_settings": {
    "auto_message": true,
    "message_template": "Hi! I'm very interested in this role. I have strong experience with your tech stack and am ready to jump in immediately. Let's discuss the opportunity!",
    "max_applications_per_day": 500,
    "apply_delay_seconds": 1,
    "batch_size": 25,
    "batch_delay_seconds": 2,
    "randomize_delays": true,
    "min_delay_variance": 0.5,
    "max_delay_variance": 1.5
  },
  "check_interval_minutes": 2,
  "log_level": "INFO",
  "analytics": {
    "track_success_rate": true,
    "track_by_board": true,
    "track_by_skill": true
  }
}
